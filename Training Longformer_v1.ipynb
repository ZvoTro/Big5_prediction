# 1. Imports
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import wandb
from datasets import Dataset
from sklearn.metrics import precision_recall_fscore_support
from transformers import (
    AutoTokenizer,
    DataCollatorWithPadding,
    EarlyStoppingCallback,
    LongformerModel,
    Trainer,
    TrainingArguments,
)
# ----- new cell -----
# 2. Config
CSV_PATH = "/content/drive/MyDrive/NLP-Sentiment-Analysis/expanded_pandora_big5_mbti.csv"
TRAITS = ["openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism"]
MBTI_AXES = ["ei", "ns", "ft", "jp"]
MODEL_NAME = "allenai/longformer-base-4096"
MAX_LENGTH = 2048
BATCH_SIZE = 2      # reduce if running out of memory
EPOCHS = 10
LEARNING_RATE = 2e-5
SEED = 42
# ----- new cell -----
# 3. Load data, add MBTI prefix, author-level split
df = pd.read_csv(CSV_PATH).dropna(
    subset=["text", "author"] + [f"{t}_bin" for t in TRAITS] + MBTI_AXES
).reset_index(drop=True)

def add_mbti_prefix(row):
    # Upper case = first pole of the axis (e.g. E, N, F, J), lower case = the other pole
    mbti = " ".join(ax.upper() if row[ax] == 1 else ax.lower() for ax in MBTI_AXES)
    return f"MBTI: {mbti}. {row['text']}"

df["text"] = df.apply(add_mbti_prefix, axis=1)

# Author-safe 90/10 split: no author appears in both sets
authors = df["author"].unique()
np.random.seed(SEED)          # same split as the published run
np.random.shuffle(authors)
split_idx = int(len(authors) * 0.9)
train_df = df[df["author"].isin(set(authors[:split_idx]))].copy()
val_df = df[df["author"].isin(set(authors[split_idx:]))].copy()

# Class weights per trait (low / medium / high), computed on the training set only
def class_weights(frame):
    rows = []
    for t in TRAITS:
        counts = frame[f"{t}_bin"].value_counts().reindex([0, 1, 2], fill_value=0)
        rows.append([counts.sum() / (3 * max(c, 1)) for c in counts])
    return torch.tensor(rows, dtype=torch.float)

weights_tensor = class_weights(train_df)

def to_dataset(frame):
    cols = {f"{t}_bin": t for t in TRAITS}
    return Dataset.from_pandas(frame[["text"] + list(cols)].rename(columns=cols), preserve_index=False)

train_dataset = to_dataset(train_df)
val_dataset = to_dataset(val_df)
print(f"Train: {len(train_df)} rows / {train_df.author.nunique()} authors | Val: {len(val_df)} rows / {val_df.author.nunique()} authors")
# ----- new cell -----
# 4. Tokenisation
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
data_collator = DataCollatorWithPadding(tokenizer=tokenizer, pad_to_multiple_of=512)

def tokenize(batch):
    return tokenizer(batch["text"], truncation=True, padding="max_length", max_length=MAX_LENGTH)

def add_labels(example):
    example["labels_big5"] = [int(example[t]) for t in TRAITS]
    return example

cols = ["input_ids", "attention_mask", "labels_big5"]
train_dataset = train_dataset.map(tokenize, batched=True).map(add_labels)
val_dataset = val_dataset.map(tokenize, batched=True).map(add_labels)
train_dataset.set_format(type="torch", columns=cols)
val_dataset.set_format(type="torch", columns=cols)
# ----- new cell -----
# 5. Model: Longformer encoder + one head for 5 traits x 3 classes
class MultiTraitLongformer(nn.Module):
    def __init__(self, base_model_name=MODEL_NAME, weights_tensor=None):
        super().__init__()
        self.encoder = LongformerModel.from_pretrained(base_model_name)
        self.dropout = nn.Dropout(0.1)
        self.classifier = nn.Linear(self.encoder.config.hidden_size, len(TRAITS) * 3)
        self.weights_tensor = weights_tensor

    def forward(self, input_ids, attention_mask=None, labels_big5=None):
        hidden = self.encoder(input_ids=input_ids, attention_mask=attention_mask).last_hidden_state
        logits = self.classifier(self.dropout(hidden[:, 0])).view(-1, len(TRAITS), 3)

        loss = None
        if labels_big5 is not None:
            loss = 0.0
            for i in range(len(TRAITS)):
                loss_fct = nn.CrossEntropyLoss(weight=self.weights_tensor[i].to(logits.device))
                loss += loss_fct(logits[:, i, :], labels_big5[:, i])
            loss /= len(TRAITS)
        return {"loss": loss, "logits":
